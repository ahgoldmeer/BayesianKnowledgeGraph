// NARS Medical Knowledge Base - Bridging Rule Version
// Bridging rules loaded FIRST to establish representational alignment
// before any data is introduced, preventing relation collapse.
//
// Bridging rule form:
//   <(*,?x,?y) --> predicate> ==> <?x --> (/,predicate,_,?y)>.
// This ensures product form and relational image form stay aligned
// throughout inference, preventing predicate concept drift.

// ============================================================
// SECTION 1: BRIDGING RULES
// ============================================================

// Align product form <-> relational image form for: caused_by
<<(*,?x,?y) --> caused_by> ==> <?x --> (/, caused_by,_,?y)>>.
<<(?x --> (/, caused_by,_,?y))> ==> <(*,?x,?y) --> caused_by>>.
5

// Align product form <-> relational image form for: is_symptom_of
<<(*,?x,?y) --> is_symptom_of> ==> <?x --> (/, is_symptom_of,_,?y)>>.
<<(?x --> (/, is_symptom_of,_,?y))> ==> <(*,?x,?y) --> is_symptom_of>>.
5

// Align product form <-> relational image form for: treated_with
<<(*,?x,?y) --> treated_with> ==> <?x --> (/, treated_with,_,?y)>>.
<<(?x --> (/, treated_with,_,?y))> ==> <(*,?x,?y) --> treated_with>>.
5


// ============================================================
// SECTION 2: DATA
// ============================================================

